+  roundFrame(b, {x, y, 21, 11}, 3, c);
+  fill(b, {x + 21, y + 3, 2, 5}, c);
+  int w = (17 * pct + 50) / 100;
+  roundFill(b, {x + 2, y + 2, w < 2 ? 2 : w, 7}, 2,
+            pct < 20 ? rgb(0xFFE14D) : c);
+  if (!s_photo && Battery::isCharging()) {
+    tinted(b, QuintIcons::IconBolt, x - 11, y + 1, c);
