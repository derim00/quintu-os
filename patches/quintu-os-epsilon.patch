+/* ----------------------------------------------------------- portrait */
+
+int bob() { return iround(2.f * sinf(s.phase * 0.09f)); }
+
+int hopHeight() {
+  if (s.hop <= 0) {
+    return 0;
+  }
+  return iround(8.f * sinf(s.hop * 3.14159f / k_hopFrames));
+}
+
+int slideOffset() {
+  if (s.slide <= 0) {
+    return 0;
+  }
+  float t = 1.f - s.slide / static_cast<float>(k_slideFrames);
+  return -iround((1.f - easeBack(t)) * 120.f);
+}
+
+void drawPortrait(Band& b) {
+  Clip c(b, k_portraitArea);
+  if (!c.ok()) {
+    return;
+  }
+  const Sister& t = sister();
+  int dx = slideOffset();
+  // halo that breathes
+  int hr = 44 + iround(2.f * sinf(s.phase * 0.07f));
+  disc(b, 56 + dx, 86, hr + 3, accent(), 50);
+  disc(b, 56 + dx, 86, hr, white(), 170);
+  // sparkles
+  constexpr int k_sparkles[][2] = {{6, 28}, {98, 36}, {4, 110}, {100, 100}};
+  for (int i = 0; i < 4; i++) {
+    int a = iround(128.f + 127.f * sinf(s.phase * 0.15f + i * 1.9f));
+    if (a > 40) {
+      tinted(b, QuintIcons::IconStar, k_sparkles[i][0] + dx, k_sparkles[i][1],
+             i % 2 ? accent() : rgb(0xFFC93C), a);
+    }
+  }
+  int x = k_portraitX + dx;
+  int y = k_portraitY + bob() - hopHeight();
+  image(b, t.portrait, x, y);
+  if (s.blink > 0) {
+    const int ex[2] = {QuintIcons::k_eyeLeftX, QuintIcons::k_eyeRightX};
+    KDColor skin = rgb(QuintIcons::k_skin), lash = rgb(QuintIcons::k_lash);
+    int ey = y + QuintIcons::k_eyeY;
+    for (int e : ex) {
+      int cx = x + e;
+      ellipse(b, {cx - 8, ey - 8, 17, 18}, skin);
+      // closed eye: a happy curve
+      line(b, cx - 7, ey + 1, cx, ey + 3, 1.7f, lash);
+      line(b, cx, ey + 3, cx + 7, ey + 1, 1.7f, lash);
+    }
+  }
+  // name plate
+  Rect p = k_namePlate.translated(dx, 0);
+  roundFill(b, p.translated(0, 2), 7, rgb(0x000000), 30);
+  roundFill(b, p, 7, accent());
+  roundFrame(b, p, 7, white(), 170);
+  text(b, t.name, p.x + p.w / 2, p.y, white(), KDFont::Size::Small,
+       Align::Center);
+  tinted(b, QuintIcons::IconHeartSmall, p.x + 5, p.y + 4, white(), 220);
+  tinted(b, QuintIcons::IconHeartSmall, p.right() - 12, p.y + 4, white(), 220);
+}
