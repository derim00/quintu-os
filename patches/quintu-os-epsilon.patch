+  constexpr int k_hearts[][2] = {{100, 118}, {292, 126}, {200, 18},
+                                 {60, 190},  {250, 192}, {170, 96}};
+  for (auto& h : k_hearts) {
+    Rect r = {h[0], h[1], 30, 30};
+    if (r.intersects(b.clip())) {
