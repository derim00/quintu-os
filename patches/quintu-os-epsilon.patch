+        cx, cy = 50 + 25 * math.cos(a), 50 + 25 * math.sin(a)
+        c.poly(petal_points(cx, cy, 24, a + math.pi / 2 + math.pi), fill=hexc(col))
+        c.poly(petal_points(cx, cy, 15, a + math.pi / 2 + math.pi), fill=hexc(0xFFFFFF, 70))
+    c.circle(50, 50, 15, fill=hexc(0xFFD447))
+    c.poly(heart_points(50, 50, 10), fill=WHITE)
