+
+def back_hair(c, col, length, width=38):
+    """The hair behind the head: length is where it ends (y)."""
+    c.ellipse(50 - width, 10, 50 + width, 86, fill=hexc(col))
+    if length > 70:
+        c.poly([(50 - width, 46), (50 + width, 46), (50 + width + 3, length - 6),
+                (50 + width - 8, length), (50 - width + 8, length),
+                (50 - width - 3, length - 6)], fill=hexc(col))
