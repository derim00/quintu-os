+/* -------------------------------------------------------------- heads */
+
+Rect headRect(int i) {
+  int cx = k_headX0 + i * k_headStep;
+  return {cx - 17, k_heads.y, 34, k_heads.h};
+}
+
+void drawHeads(Band& b) {
+  if (!k_heads.intersects(b.clip())) {
+    return;
+  }
+  for (int i = 0; i < k_numberOfSisters; i++) {
+    int cx = k_headX0 + i * k_headStep, cy = k_headY;
+    if (!headRect(i).intersects(b.clip())) {
+      continue;
+    }
+    if (i == s.sister) {
+      int hop =
+          s.headHop > 0 ? iround(6.f * sinf(s.headHop * 3.14159f / 9.f)) : 0;
+      int pr = iround(1.5f + 1.5f * sinf(s.phase * 0.2f));
+      disc(b, cx, cy - hop, 13 + pr, accent(), 90);
+      disc(b, cx, cy - hop, 12, accent());
+      disc(b, cx, cy - hop, 10, white());
+      image(b, k_sisters[i].head, cx - 9, cy - 9 - hop);
+    } else {
+      disc(b, cx, cy, 11, rgb(k_sisters[i].hair), 140);
+      disc(b, cx, cy, 10, white(), 210);
+      image(b, k_sisters[i].head, cx - 9, cy - 9, 0, 190);
+    }
+  }
+}
+
+/* ----------------------------------------------------------- carousel */
+
+int selectionLift() {
+  float lift = 4.f;
+  if (s.pop > 0) {
+    lift += 6.f * sinf(s.pop * 3.14159f / 8.f);
+  }
+  return iround(lift);
+}
+
+float appearProgress(int order) {
+  if (s.appear <= 0) {
+    return 1.f;
+  }
+  int t = k_appearFrames - s.appear - order;
+  return clamp01(t / 7.f);
+}
+
+Rect carouselTile(int i) {
+  float rel = i - s.scroll;
+  int cx = 160 + iround(rel * k_spacing);
+  return {cx - k_tile / 2, k_carouselY, k_tile, k_tile};
+}
+
+void drawTileFrame(Band& b, Rect t, int radius, bool selected) {
+  roundFill(b, {t.x + 4, t.bottom() - 1, t.w - 8, 4}, 2, rgb(0x000000), 26);
+  roundFill(b, t, radius, white());
+  roundFrame(b, t, radius, selected ? accent() : rgb(sister().petal),
+             selected ? 256 : 170);
+}
+
+void drawSelectionHeart(Band& b, Rect r) {
+  int bounce = iround(2.5f * sinf(s.phase * 0.28f));
+  int x = r.x + r.w / 2 - 6, y = r.y - 8 - bounce;
+  tinted(b, QuintIcons::IconHeart, x + 1, y + 1, accentDark(), 120);
+  tinted(b, QuintIcons::IconHeart, x, y, accent());
+}
+
+void drawArrows(Band& b) {
+  int n = numberOfItems();
+  int dx = iround(2.f * sinf(s.phase * 0.2f));
+  if (s.scroll > 0.5f) {
+    Rect r = {4 - dx, 183, 14, 18};
+    if (r.intersects(b.clip())) {
+      roundFill(b, r, 6, white(), 235);
+      text(b, "<", r.x + 7, r.y + 2, accent(), KDFont::Size::Small,
+           Align::Center);
+    }
+  }
+  if (s.scroll < n - 1.5f) {
+    Rect r = {302 + dx, 183, 14, 18};
+    if (r.intersects(b.clip())) {
+      roundFill(b, r, 6, white(), 235);
+      text(b, ">", r.x + 7, r.y + 2, accent(), KDFont::Size::Small,
+           Align::Center);
+    }
+  }
+}
+
+void drawCarousel(Band& b) {
+  Clip c(b, k_carouselArea);
+  if (!c.ok()) {
+    return;
+  }
+  int n = numberOfItems();
+  for (int i = 0; i < n; i++) {
+    Rect t = carouselTile(i);
+    if (t.right() < -10 || t.x > k_screenWidth + 10) {
+      continue;
+    }
+    int order = i - s.selected;
+    order = order < 0 ? -order : order;
+    float a = appearProgress(order * 2);
+    if (a <= 0.f) {
+      continue;
+    }
+    int drop = iround((1.f - easeBack(a)) * 34.f);
+    bool sel = i == s.selected;
+    Rect r = t.translated(0, -(sel ? selectionLift() : 0) + drop);
+    if (!r.inset(-12).intersects(b.clip())) {
+      continue;
+    }
+    drawTileFrame(b, r, 12, sel);
+    drawItemIcon(b, i, r.x + 3, r.y + 3, false);
+    if (sel && a >= 1.f) {
+      roundFrame(b, r.inset(-2), 14, accent(), 140);
+      drawSelectionHeart(b, r);
+    }
+  }
+  drawArrows(b);
+}
+
+/* --------------------------------------------------------------- grid */
+
+Rect gridTile(int i) {
+  int page = i / k_perGridPage, k = i % k_perGridPage;
+  float offset = (page - s.gridScroll) * k_screenWidth;
+  int x = k_gridX0 + (k % k_gridColumns) * k_gridCellW + iround(offset);
+  int y = k_gridY0 + (k / k_gridColumns) * k_gridCellH;
+  return {x + 2, y + 1, 30, 30};
+}
+
+void drawGrid(Band& b) {
+  Clip c(b, k_carouselArea);
+  if (!c.ok()) {
+    return;
+  }
+  int n = numberOfItems();
+  for (int i = 0; i < n; i++) {
+    Rect t = gridTile(i);
+    int k = i % k_perGridPage;
+    float a = appearProgress(k % k_gridColumns + (k / k_gridColumns) * 2);
+    if (a <= 0.f) {
+      continue;
+    }
+    int drop = iround((1.f - easeBack(a)) * 20.f);
+    bool sel = i == s.selected;
+    int grow = sel ? (s.pop > 0 ? 3 : 1) : 0;
+    Rect r = t.translated(0, drop).inset(-grow);
+    if (!r.inset(-10).intersects(b.clip())) {
+      continue;
+    }
+    drawTileFrame(b, r, 8, sel);
+    drawItemIcon(b, i, r.x + r.w / 2 - 12, r.y + r.h / 2 - 12, true);
+    if (sel && a >= 1.f) {
+      roundFrame(b, r.inset(-2), 10, accent(), 160);
+      int bounce = iround(1.5f * sinf(s.phase * 0.28f));
+      tinted(b, QuintIcons::IconHeartSmall, r.right() - 6, r.y - 3 - bounce,
+             accent());
+    }
+  }
+}
+
+/* --------------------------------------------------------- bottom bar */
+
+void drawBottomBar(Band& b) {
+  if (!k_bottomBar.intersects(b.clip())) {
+    return;
+  }
+  vgradient(b, k_bottomBar, accent(), accentDark());
+  fill(b, {0, k_bottomBar.y, k_screenWidth, 1}, white(), 110);
+  text(b,
+       "OK ouvrir  Var soeur  Outils vue",
+       160, k_bottomBar.y + 2, white(), KDFont::Size::Small, Align::Center);
+  int beat = (s.phase % 24) < 3 ? 1 : 0;
+  tinted(b, QuintIcons::IconHeart, 5 - beat, k_bottomBar.y + 3 - beat,
+         white());
+  tinted(b, QuintIcons::IconHeart, 303 - beat, k_bottomBar.y + 3 - beat,
+         white());
+}
+
+/* -------------------------------------------------------------- intro */
+
+void drawIntro(Band& b) {
+  int t = k_introFrames - s.intro;
+  vgradient(b, k_screen, rgb(0xFFF0F6), rgb(0xFFD0E2));
+  // falling petals in all five colours
+  for (int i = 0; i < k_petals; i++) {
+    Rect r = petalRect(i);
+    if (r.intersects(b.clip())) {
+      tinted(b, petalIcon(i), r.x, r.y,
+             rgb(k_sisters[i % k_numberOfSisters].hair), 180);
+    }
+  }
+  // five petals spiral in and turn into a flower
+  constexpr float k_cx = 160.f, k_cy = 84.f;
+  for (int k = 0; k < k_numberOfSisters; k++) {
+    if (t - k * 3 <= 0) {
+      continue;
+    }
+    float p = easeOut((t - k * 3) / 24.f);
+    float a = -1.5708f + k * 1.2566f + t * 0.06f + (1.f - p) * 3.f;
+    float rad = 30.f + 150.f * (1.f - p);
+    int x = iround(k_cx + rad * cosf(a)) - 10;
+    int y = iround(k_cy + rad * sinf(a)) - 10;
+    tinted(b, QuintIcons::IconPetalBig, x, y, rgb(k_sisters[k].hair));
+  }
+  if (t > 18) {
+    int size = iround(48.f * easeBack((t - 18) / 12.f));
+    if (size > 2) {
+      image(b, QuintIcons::IconLogo, iround(k_cx) - size / 2,
+            iround(k_cy) - size / 2, size);
+    }
+  }
+  if (t > 30) {
+    int scale = iround(110.f * easeBack((t - 30) / 10.f));
+    if (scale > 8) {
+      scaledText(b, "Quintu-OS", 161, 131, white(), scale, Align::Center);
+      scaledText(b, "Quintu-OS", 160, 130, rgb(0xC2407A), scale,
+                 Align::Center);
+    }
+  }
+  if (t > 40) {
+    const char* subtitle = "cinq soeurs, une calculatrice";
+    char buf[40];
+    int len = static_cast<int>(strlen(subtitle));
+    int n = (t - 40) * 2;
+    n = n > len ? len : n;
+    memcpy(buf, subtitle, n);
+    buf[n] = 0;
+    text(b, buf, 160 - len * glyphWidth() / 2, 162, rgb(0x9C4A70));
+  }
+  for (int k = 0; k < k_numberOfSisters; k++) {
+    int st = t - 46 - k * 3;
+    if (st <= 0) {
+      continue;
+    }
+    int drop = iround((1.f - easeBack(st / 8.f)) * 30.f);
+    int cx = 116 + k * 22, cy = 202 + drop;
+    disc(b, cx, cy, 11, rgb(k_sisters[k].hair));
+    disc(b, cx, cy, 10, white());
+    image(b, k_sisters[k].head, cx - 9, cy - 9);
+  }
+}
+
+/* --------------------------------------------------------------- zoom */
+
+void drawZoom(Band& b) {
+  Rect z = s.zoom;
+  if (!z.intersects(b.clip())) {
+    return;
+  }
+  {
+    Clip c(b, z);
+    if (c.ok()) {
+      vgradient(b, z, accent(), accentDark());
+    }
+  }
+  int radius = z.w > 200 ? 0 : (z.w > 100 ? 8 : 12);
+  roundFrame(b, z, radius, white(), 180);
+  int cx = z.x + z.w / 2, cy = z.y + z.h / 2;
+  if (z.w > 120) {
+    Clip c(b, z);
+    tinted(b, QuintIcons::IconHeartBig, cx - 15, cy - 76, white(), 140);
+    Rect f = {cx - 30, cy - 40, 60, 60};
+    roundFill(b, f.translated(0, 3), 13, rgb(0x000000), 40);
+    roundFill(b, f, 13, white());
+    if (s.zoomItem >= 0) {
+      drawItemIcon(b, s.zoomItem, f.x + 8, f.y + 8, false);
+      text(b, itemLabel(s.zoomItem), cx, cy + 28, white(),
+           KDFont::Size::Large, Align::Center);
+    }
+    for (int i = 0; i < k_numberOfSisters; i++) {
+      tinted(b, QuintIcons::IconHeartSmall, cx - 26 + i * 11, cy + 56,
+             rgb(k_sisters[i].hair));
+    }
+  } else if (s.zoomItem >= 0) {
+    drawItemIcon(b, s.zoomItem, cx - 22, cy - 22, false);
+  }
+}
+
+void drawWipe(Band& b) {
+  if (s.wipe < 0) {
+    return;
+  }
+  Rect bar = {s.wipe - 14, 0, 18, k_screenHeight};
+  if (!bar.intersects(b.clip())) {
+    return;
+  }
+  for (int i = 0; i < 8; i++) {
+    fill(b, {bar.x + 8 + i, 0, 1, k_screenHeight}, white(), 30 + i * 28);
+  }
+  for (int y = -6; y < k_screenHeight; y += 20) {
+    int off = ((y + 6) / 20) % 2 * 5;
+    tinted(b, QuintIcons::IconHeart, bar.x + off - 2, y + (s.wipe / 3) % 20,
+           accent());
+  }
+}
+
+/* ------------------------------------------------------------- actions */
+
+Rect tileArea(int i) {
+  if (s.view == View::Carousel) {
+    Rect r = carouselTile(i).inset(-6);
+    return {r.x, k_carouselArea.y, r.w, k_carouselArea.h};
+  }
+  return gridTile(i).inset(-8);
+}
+
+void waitUntil(uint32_t target) {
+  while (static_cast<uint32_t>(Ion::Timing::millis()) < target) {
+    Ion::Timing::msleep(1);
+  }
+}
+
+Rect zoomStep(Rect from, float t) {
+  return {from.x + iround((k_screen.x - from.x) * t),
+          from.y + iround((k_screen.y - from.y) * t),
+          from.w + iround((k_screen.w - from.w) * t),
+          from.h + iround((k_screen.h - from.h) * t)};
+}
+
+// The tile grows into a full-screen splash, then the app opens
+void zoomOpen(Rect from, int item) {
+  s.zoomItem = item;
+  if (!s_painter) {
+    return;
+  }
+  s.launching = true;
+  constexpr int k_steps = 10;
+  uint32_t start = Ion::Timing::millis();
+  for (int i = 1; i <= k_steps; i++) {
+    Rect old = s.zoom;
+    s.zoom = zoomStep(from, easeOut(i / static_cast<float>(k_steps)));
+    paint(unite(old, s.zoom).inset(-1));
+    waitUntil(start + i * 22);
+  }
+  waitUntil(Ion::Timing::millis() + 140);
+}
+
+void launchItem(int item, Rect from) {
+  if (item < 0 || item >= numberOfItems()) {
+    return;
+  }
+  zoomOpen(from, item);
+  if (item < s_numberOfBuiltin) {
+    s_launch = {Item::Kind::Builtin, s_builtin[item]};
+  } else {
+    s_launch = {Item::Kind::External,
+                static_cast<int16_t>(item - s_numberOfBuiltin)};
+  }
+}
+
+void showGreeting() {
+  s.greet = k_greetFrames;
+  s.typed = 0;
+  s.bubblePop = k_popFrames;
+  s.hop = k_hopFrames;
+  s.headHop = 9;
+}
+
+void startHome() {
+  s.slide = k_slideFrames;
+  s.bubblePop = k_popFrames;
+  s.typed = 0;
+  s.appear = k_appearFrames;
+}
+
+void setSister(int next) {
+  next = (next + k_numberOfSisters) % k_numberOfSisters;
+  if (next == s.sister) {
+    return;
+  }
+  s.sister = next;
+  if (s_painter) {
+    // the new colours sweep from left to right behind a column of hearts
+    int prev = 0;
+    constexpr int k_steps = 13;
+    uint32_t start = Ion::Timing::millis();
+    for (int i = 1; i <= k_steps; i++) {
+      int x = iround(k_screenWidth * easeOut(i / static_cast<float>(k_steps)));
+      s.wipe = i < k_steps ? x : -1;
+      paint({prev - 18, 0, x - prev + 24, k_screenHeight});
+      prev = x;
+      waitUntil(start + i * 20);
+    }
+    s.wipe = -1;
+  }
+  s.slide = k_slideFrames;
+  showGreeting();
+  invalidateAll();
+}
+
+void setView(View v) {
+  if (v == s.view) {
+    return;
+  }
+  s.view = v;
+  s.scroll = static_cast<float>(s.selected);
+  s.gridScroll = static_cast<float>(s.selected / k_perGridPage);
+  s.appear = k_appearFrames;
+  invalidate(k_carouselArea);
+  invalidate(k_bottomBar);
+}
+
+void select(int index) {
+  int n = numberOfItems();
+  if (n == 0) {
+    return;
+  }
+  index = index < 0 ? 0 : (index >= n ? n - 1 : index);
+  if (index == s.selected && s.greet == 0) {
+    return;
+  }
+  invalidate(tileArea(s.selected));
+  s.selected = index;
+  s.pop = 8;
+  s.banner = k_bannerFrames;
+  s.typed = 0;
+  if (s.greet > 0) {
+    s.greet = 0;
+    s.bubblePop = k_popFrames / 2;
+  }
+  invalidate(tileArea(s.selected));
+  invalidate(k_bubbleArea);
+}
+
+void moveGrid(int dx, int dy) {
+  int n = numberOfItems();
+  int i = s.selected;
+  int page = i / k_perGridPage, k = i % k_perGridPage;
+  int col = k % k_gridColumns, row = k / k_gridColumns;
+  if (dy != 0) {
+    int target = i + dy * k_gridColumns;
+    if ((dy > 0 && (row == k_gridRows - 1 || target >= n)) ||
+        (dy < 0 && row == 0)) {
+      return;
+    }
+    select(target);
+    return;
+  }
+  if (dx > 0 && (col == k_gridColumns - 1 || i == n - 1)) {
+    int target = (page + 1) * k_perGridPage + row * k_gridColumns;
+    if (target >= n) {
+      target = n - 1;
+    }
+    if (target / k_perGridPage != page) {
+      select(target);
+    }
+    return;
+  }
+  if (dx < 0 && col == 0) {
+    if (page > 0) {
+      select((page - 1) * k_perGridPage + row * k_gridColumns +
+             k_gridColumns - 1);
+    }
+    return;
+  }
+  select(i + dx);
+}
+
+}  // namespace
+
+/* --------------------------------------------------------------- shell */
+
+namespace Shell {
+
+#if !PLATFORM_DEVICE
+void photoSession();
+#endif
+
+void setInvalidator(void (*inv)(Rect)) { s_invalidate = inv; }
+
+void setPainter(void (*p)(Rect)) { s_painter = p; }
+
+void enter() {
+  listApps();
+  if (!s_petalsReady) {
+    initPetals();
+  }
+  int n = numberOfItems();
+  if (s.selected >= n) {
+    s.selected = n > 0 ? n - 1 : 0;
+  }
+  s.scroll = static_cast<float>(s.selected);
+  s.gridScroll = static_cast<float>(s.selected / k_perGridPage);
+  s.launching = false;
+  s.wipe = -1;
+  s.hop = 0;
+  s_launch = k_noItem;
+  if (!s.booted) {
+    s.booted = true;
+    s.intro = k_introFrames;
+  } else {
+    // back from an app: she slides back in, the tiles drop in again
+    s.greet = 0;
+    startHome();
+  }
+#if !PLATFORM_DEVICE
+  static bool s_photoDone = false;
+  if (!s_photoDone && getenv("DS_SHOTS")) {
+    s_photoDone = true;
+    photoSession();
+    listApps();
+  }
+#endif
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+void launchFailed() {
+  s.launching = false;
+  invalidateAll();
+}
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (s.intro > 0) {
+    // any key skips the intro
+    s.intro = 0;
+    startHome();
+    showGreeting();
+    invalidateAll();
+    if (e != Events::Home) {
+      return true;
+    }
+  }
+  if (e == Events::Right || e == Events::Left) {
+    int dx = e == Events::Right ? 1 : -1;
+    if (s.view == View::Carousel) {
+      select(s.selected + dx);
+    } else {
+      moveGrid(dx, 0);
+    }
+    return true;
+  }
+  if (e == Events::Up || e == Events::Down) {
+    int d = e == Events::Down ? 1 : -1;
+    if (s.view == View::Grid) {
+      moveGrid(0, d);
+    } else {
+      setSister(s.sister + d);
+    }
+    return true;
+  }
+  if (e == Events::Home || e == Events::Back) {
+    select(0);
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    if (numberOfItems() > 0) {
+      s.hop = k_hopFrames;
+      launchItem(s.selected, s.view == View::Carousel
+                                 ? carouselTile(s.selected).translated(
+                                       0, -selectionLift())
+                                 : gridTile(s.selected));
+    }
+    return true;
+  }
+  if (e == Events::Toolbox) {
+    setView(s.view == View::Carousel ? View::Grid : View::Carousel);
+    return true;
+  }
+  if (e == Events::Var) {
+    setSister(s.sister + 1);
+    return true;
+  }
+  // Keys 1 to 9 select an app (twice: open it), 0 the settings
+  const char* t = e.text();
+  if (t && t[0] >= '0' && t[0] <= '9' && t[1] == 0) {
+    int index = t[0] == '0' ? s_numberOfBuiltin - 1 : t[0] - '1';
+    if (index < numberOfItems()) {
+      if (index == s.selected && s.greet == 0) {
+        return handleEvent(Events::OK);
+      }
+      select(index);
+    }
+    return true;
+  }
+  return false;
+}
+
+bool tick() {
+  int battery = batteryPercent();
+  if (battery != s.lastBattery) {
+    s.lastBattery = battery;
+    invalidate({250, 0, 70, 18});
+  }
+  return false;
+}
+
+int framePeriod() { return k_framePeriod; }
+
+bool frame() {
+  s.phase++;
+  if (s.launching) {
+    return false;
+  }
+  if (s.intro > 0) {
+    s.intro--;
+    if (s.intro == 0) {
+      startHome();
+      showGreeting();
+    }
+    paint(k_screen);
+    return false;
+  }
+  // Carousel and grid glide towards the selection
+  bool moved = false;
+  float target = static_cast<float>(s.selected);
+  if (fabsf(target - s.scroll) > 0.002f) {
+    s.scroll += (target - s.scroll) * 0.34f;
+    if (fabsf(target - s.scroll) < 0.01f) {
+      s.scroll = target;
+    }
+    moved = s.view == View::Carousel;
+  }
+  float page = static_cast<float>(s.selected / k_perGridPage);
+  if (fabsf(page - s.gridScroll) > 0.002f) {
+    s.gridScroll += (page - s.gridScroll) * 0.3f;
+    if (fabsf(page - s.gridScroll) < 0.004f) {
+      s.gridScroll = page;
+    }
+    moved = moved || s.view == View::Grid;
+  }
+  if (s.appear > 0) {
+    s.appear--;
+    moved = true;
+  }
+  if (moved) {
+    paint(k_carouselArea);
+  } else if (numberOfItems() > 0 && (s.pop > 0 || s.phase % 2 == 0)) {
+    // the heart bounces, the selection pops
+    paint(tileArea(s.selected));
+    if (s.view == View::Carousel) {
+      paint({0, 180, 22, 24});
+      paint({298, 180, 22, 24});
+    }
+  }
+  if (s.pop > 0) {
+    s.pop--;
+  }
+  // Portrait: slide, hop, blink, bob, halo and sparkles
+  bool portrait = false;
+  if (s.slide > 0) {
+    s.slide--;
+    portrait = true;
+  }
+  if (s.hop > 0) {
+    s.hop--;
+    portrait = true;
+  }
+  if (s.blink > 0) {
+    s.blink--;
+    portrait = portrait || s.blink == 0;
+  } else if (--s.blinkIn <= 0) {
+    s.blink = 4;
+    s.blinkIn = 60 + (s.phase * 37) % 70;
+    portrait = true;
+  }
+  int b = bob();
+  if (b != s.lastBob) {
+    s.lastBob = b;
+    portrait = true;
+  }
+  if (portrait || s.phase % 3 == 0) {
+    paint(k_portraitArea);
+  }
+  // Bubble: pop, slide, typewriter, floating icon
+  if (s.bubblePop > 0) {
+    s.bubblePop--;
+    paint(k_bubbleArea);
+  } else if (s.banner > 0) {
+    s.banner--;
+    paint(k_bubble);
+  } else if (s.typed < 90) {
+    s.typed += s.greet > 0 ? 2 : 3;
+    paint(k_bubble);
+  } else if (s.phase % 3 == 0 && s.greet == 0) {
+    paint({k_bubble.x + 8, k_bubble.y + 8, 54, 58});
+  }
+  if (s.greet > 0) {
+    s.greet--;
+    if (s.greet % 4 == 0) {
+      paint({k_bubble.x + 60, k_bubble.y + 6, 80, 20});
+    }
+    if (s.greet == 0) {
+      s.banner = k_bannerFrames;
+      s.typed = 0;
+      paint(k_bubble);
+    }
+  }
+  // Heads of the sisters
+  if (s.headHop > 0) {
+    s.headHop--;
+    paint(k_heads);
+  } else if (s.phase % 3 == 0) {
+    paint(headRect(s.sister));
+  }
+  // Beating hearts of the bars
+  if (s.phase % 20 == 0 || s.phase % 20 == 3) {
+    paint({130, 0, 60, 18});
+  }
+  if (s.phase % 24 == 0 || s.phase % 24 == 3) {
+    paint({0, k_bottomBar.y, 20, 18});
+    paint({298, k_bottomBar.y, 22, 18});
+  }
+  // Falling petals
+  if (s.phase % 2 == 0) {
+    for (int i = 0; i < k_petals; i++) {
+      Rect r = petalRect(i);
+      if (r.x != s_petalRect[i].x || r.y != s_petalRect[i].y) {
+        paint(unite(r, s_petalRect[i]));
+        s_petalRect[i] = r;
+      }
+    }
+  }
+  return false;
+}
+
+void render(Band& b) {
+  if (s.intro > 0 && k_introFrames - s.intro <= k_introFade) {
+    drawIntro(b);
+    return;
+  }
+  drawBackground(b);
+  drawStatus(b);
+  drawPortrait(b);
+  drawBubble(b);
+  drawHeads(b);
+  if (s.view == View::Carousel) {
+    drawCarousel(b);
+  } else {
+    drawGrid(b);
+  }
+  drawBottomBar(b);
+  drawPetals(b);
+  if (s.intro > 0) {
+    // the intro fades out over the home screen
+    int t = k_introFrames - s.intro;
+    int alpha = iround(256.f * (1.f - easeOut((t - k_introFade) / 16.f)));
+    if (alpha > 0) {
+      fill(b, k_screen, rgb(0xFFE6F0), alpha);
+    }
+  }
+  if (s.launching) {
+    drawZoom(b);
+  }
+  drawWipe(b);
+}
+
+/* ------------------------------------------------- photos (simulator) */
+
+#if !PLATFORM_DEVICE
+
+namespace {
+
+uint16_t s_shot[k_screenWidth * k_screenHeight];
+int s_gifFrame = 0;
+
+void shoot(const char* name) {
+  Band band;
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    render(band);
+    for (int j = 0; j < Band::k_maxHeight; j++) {
+      const KDColor* row = band.pixels() + j * k_screenWidth;
+      for (int i = 0; i < k_screenWidth; i++) {
+        s_shot[(y + j) * k_screenWidth + i] = static_cast<uint16_t>(row[i]);
+      }
+    }
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s/%s.raw", getenv("DS_SHOTS"), name);
+  FILE* f = fopen(path, "wb");
+  if (f) {
+    fwrite(s_shot, 2, k_screenWidth * k_screenHeight, f);
+    fclose(f);
+  }
+}
+
+void wait(int frames, const char* gif = nullptr) {
+  for (int i = 0; i < frames; i++) {
+    frame();
+    if (gif) {
+      char name[64];
+      snprintf(name, sizeof(name), "%s_%04d", gif, s_gifFrame++);
+      shoot(name);
+    }
+  }
+}
+
+void key(Event e, int frames, const char* gif = nullptr) {
+  handleEvent(e);
+  takeLaunch();
+  wait(frames, gif);
+}
+
+void zoomShots(const char* gif) {
+  Rect from = carouselTile(s.selected).translated(0, -selectionLift());
+  s.zoomItem = s.selected;
+  s.launching = true;
+  for (int i = 1; i <= 10; i++) {
+    s.zoom = zoomStep(from, easeOut(i / 10.f));
+    wait(1, gif);
+  }
+  wait(6, gif);
+  s.launching = false;
+}
+
+void freshState() {
+  s = State();
+  s.booted = true;
+}
+
+}  // namespace
+
+void photoSession() {
+  // Same apps as on the calculator, plus two games
+  s_photo = true;
+  auto savedPainter = s_painter;
+  auto savedInvalidate = s_invalidate;
+  s_painter = nullptr;
+  s_invalidate = nullptr;
+  s_numberOfBuiltin = 0;
+  for (int a = 0; a < k_numberOfArts; a++) {
+    s_builtin[s_numberOfBuiltin] = s_numberOfBuiltin + 1;
+    s_builtinArt[s_numberOfBuiltin] = a;
+    s_builtinLabel[s_numberOfBuiltin] = k_builtinArt[a].label;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = 2;
+  State saved = s;
+
+  freshState();
+  s.intro = k_introFrames;
+  wait(54);
+  shoot("intro");
+  wait(k_introFrames - 54 + 40);
+  shoot("bonjour");
+  wait(k_greetFrames);
+  key(Events::Right, 6);
+  key(Events::Right, 6);
+  key(Events::Right, 30);
+  shoot("accueil");
+  const char* names[] = {"ichika", "nino", "miku", "yotsuba", "itsuki"};
+  for (int i = 0; i < k_numberOfSisters; i++) {
+    freshState();
+    s.sister = i;
+    s.selected = 3 + i;
+    s.scroll = s.selected;
+    s.blinkIn = 1000;
+    wait(40);
+    shoot(names[i]);
+  }
+  freshState();
+  s.sister = 2;
+  s.blinkIn = 1000;
+  s.selected = 9;
+  setView(View::Grid);
+  wait(30);
+  shoot("grille");
+
+  // GIF 1: boot, moving around, opening an app
+  freshState();
+  s.intro = k_introFrames;
+  wait(k_introFrames + 34, "gifaccueil");
+  Event path[] = {Events::Right, Events::Right, Events::Right, Events::Left,
+                  Events::Right, Events::Right};
+  for (Event e : path) {
+    key(e, 10, "gifaccueil");
+  }
+  wait(12, "gifaccueil");
+  zoomShots("gifaccueil");
+
+  // GIF 2: the five sisters
+  freshState();
+  s.selected = 2;
+  s.scroll = 2;
+  wait(6, "gifsoeurs");
+  for (int i = 1; i <= k_numberOfSisters; i++) {
+    s.sister = i % k_numberOfSisters;
+    s.slide = k_slideFrames;
+    showGreeting();
+    wait(34, "gifsoeurs");
+  }
+
+  s = saved;
+  s_photo = false;
+  s_painter = savedPainter;
+  s_invalidate = savedInvalidate;
+  if (getenv("DS_SHOTS_EXIT")) {
+    exit(0);
+  }
+}
+
+#endif
+
