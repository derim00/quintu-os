+def eye(c, cx, cy, brow):
+    c.ellipse(cx - 7, cy - 8, cx + 7, cy + 8, fill=hexc(0xFFFFFF))
+    c.ellipse(cx - 6, cy - 7, cx + 6, cy + 8, fill=hexc(IRIS))
+    c.ellipse(cx - 6, cy - 7, cx + 6, cy + 1, fill=hexc(IRIS_DARK, 170))
+    c.ellipse(cx - 4, cy + 1, cx + 4, cy + 7, fill=hexc(0x7FA6FF, 150))
+    c.ellipse(cx - 2.6, cy - 3, cx + 2.6, cy + 3.4, fill=hexc(PUPIL))
+    c.circle(cx + 2.4, cy - 3.2, 2.3, fill=WHITE)
+    c.circle(cx - 2.6, cy + 4.2, 1.2, fill=hexc(0xFFFFFF, 210))
+    # upper lash, thicker on the outside
+    out = -1 if cx < 50 else 1
+    pts = [(cx + 8.5 * math.cos(a), cy - 7.5 * math.sin(a) + 1.5)
+           for a in [math.pi * k / 16 for k in range(17)]]
+    c.line(pts, 2.4, fill=hexc(LASH))
+    c.line([(cx + out * 8, cy - 4), (cx + out * 11, cy - 7)], 1.8, fill=hexc(LASH))
+    # eyebrow
+    c.line([(cx - 6, cy - 13 - (0 if out < 0 else 1)), (cx + 6, cy - 13 - (1 if out < 0 else 0))],
+           1.6, fill=hexc(brow))
