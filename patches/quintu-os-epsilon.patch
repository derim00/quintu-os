+
+def gradient_square(c, top, bottom, r=20, inset=4):
+    """A glossy rounded square, like a handheld console app icon."""
+    layer = Image.new("RGBA", c.img.size, CLEAR)
+    mask = Image.new("L", c.img.size, 0)
+    md = ImageDraw.Draw(mask)
+    s = c.s
+    md.rounded_rectangle([s(inset), s(inset), s(D - inset), s(D - inset)], radius=s(r), fill=255)
+    t, b = hexc(top), hexc(bottom)
+    grad = Image.new("RGBA", c.img.size)
+    gd = ImageDraw.Draw(grad)
+    for y in range(c.img.size[1]):
+        k = y / (c.img.size[1] - 1)
+        gd.line([(0, y), (c.img.size[0], y)], fill=tuple(int(t[i] + (b[i] - t[i]) * k) for i in range(4)))
+    layer.paste(grad, (0, 0), mask)
+    c.img.alpha_composite(layer)
+    # glossy reflection on the top half
+    gloss = Image.new("RGBA", c.img.size, (255, 255, 255, 0))
+    gm = Image.new("L", c.img.size, 0)
+    ImageDraw.Draw(gm).ellipse([s(-20), s(-62), s(120), s(46)], fill=70)
+    m2 = Image.new("L", c.img.size, 0)
+    m2.paste(gm, (0, 0), mask)
+    gloss.putalpha(m2)
+    c.img.alpha_composite(gloss)
+    # thin darker rim
+    c.rrect(inset, inset, D - inset, D - inset, r, fill=None, outline=hexc(bottom, 140), width=1.6)
+
+
+def sym(c, fn):
+    """Draws a white symbol with a soft drop shadow under it."""
+    shadow = Canvas()
+    fn(shadow, hexc(INK, 90))
+    sh = shadow.img.copy()
+    c.img.alpha_composite(sh, (0, int(c.s(2.5))))
+    fn(c, WHITE)
+
