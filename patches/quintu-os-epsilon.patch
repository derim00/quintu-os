+def butterfly(c, cx, cy, flip):
+    s = -1 if flip else 1
+    black, green = hexc(0x24212B), hexc(0x77D49B)
+    c.poly([(cx, cy), (cx + s * 12, cy - 11), (cx + s * 14, cy - 2)], fill=black)
+    c.poly([(cx, cy), (cx + s * 11, cy + 9), (cx + s * 4, cy + 11)], fill=black)
+    c.line([(cx + s * 4, cy - 3), (cx + s * 11, cy - 8)], 1.4, fill=green)
+    c.line([(cx + s * 3, cy + 3), (cx + s * 8, cy + 7)], 1.2, fill=green)
+    c.circle(cx, cy, 2.4, fill=black)
