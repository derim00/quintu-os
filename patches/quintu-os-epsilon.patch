+  for (int i = 0; i < k_numberOfSisters; i++) {
+    int x = 140 + i * 10;
+    if (i == s.sister) {
+      int beat = (s.phase % 20) < 3 ? 1 : 0;
+      tinted(b, QuintIcons::IconHeart, x - 3 - beat, 3 - beat,
+             rgb(k_sisters[i].hair));
+    } else {
+      tinted(b, QuintIcons::IconHeartSmall, x, 6, rgb(k_sisters[i].hair));
+    }
+  }
+  char buf[8];
+  int i = appendInt(buf, 0, batteryPercent());
+  appendText(buf, i, "%");
