+# Five original chibi portraits (fan art, drawn here with shapes): same face,
+# five hair styles and colours, each with her own accessory. Design space
+# 100 x 122, rendered at 92 x 112.
+
+SKIN = 0xFFE7D9
+SKIN_SHADOW = 0xF6C9B8
+BLAZER = 0x2D3A6B
+BLAZER_LIGHT = 0x3E4F8C
+SHIRT = 0xFFFFFF
+LASH = 0x3A2430
+IRIS = 0x3F66DA
+IRIS_DARK = 0x1E2F8E
+PUPIL = 0x131A48
+BLUSH = 0xFF8FA6
+
+PORTRAIT_W = 92
+PH = 122
+EYES = ((38, 62), (62, 62))
