+void drawItemIcon(Band& b, int item, int x, int y, bool small) {
+  if (item < s_numberOfBuiltin) {
+    int icon = builtinIcon(item);
+    image(b, small ? icon + QuintIcons::k_smallOffset : icon, x, y);
+    return;
+  }
+  if (s_photo) {
+    image(b, small ? QuintIcons::IconGameSmall : QuintIcons::IconGame, x, y);
+    return;
+  }
+  gameIcon(b,
+           AppsContainer::sharedAppsContainer()->externalAppAtIndex(
+               item - s_numberOfBuiltin),
+           x, y, small ? 24 : 44);
+}
+
+Rect bubbleRect() {
+  if (s.bubblePop <= 0) {
+    return k_bubble;
+  }
+  float t = easeBack(1.f - s.bubblePop / static_cast<float>(k_popFrames));
+  float k = 0.35f + 0.65f * t;
+  int w = iround(k_bubble.w * k), h = iround(k_bubble.h * k);
+  // grows from the side of the tail
+  return {k_bubble.x, k_bubble.y + (k_bubble.h - h) / 2, w, h};
+}
+
+void drawBubble(Band& b) {
+  if (!k_bubbleArea.intersects(b.clip())) {
+    return;
+  }
+  Rect r = bubbleRect();
+  roundFill(b, r.translated(0, 3), 13, rgb(0x000000), 28);
+  roundFill(b, r, 13, white(), 245);
+  roundFrame(b, r, 13, accent(), 150);
+  // tail: little thought dots towards her
+  disc(b, r.x - 6, r.y + r.h / 2 + 8, 5, white(), 240);
+  disc(b, r.x - 13, r.y + r.h / 2 + 18, 3, white(), 230);
+  if (s.bubblePop > 3) {
+    return;
+  }
+  Clip c(b, r.inset(3));
+  if (!c.ok()) {
+    return;
+  }
+  char line[48];
+  int budget = s.typed;
+  if (s.greet > 0) {
+    // her greeting
+    text(b, sister().name, r.x + 12, r.y + 7, accent(), KDFont::Size::Large);
+    int w = textWidth(sister().name, KDFont::Size::Large);
+    for (int i = 0; i < 3; i++) {
+      int up = iround(2.f * sinf(s.phase * 0.3f + i));
+      tinted(b, QuintIcons::IconHeartSmall, r.x + 18 + w + i * 10,
+             r.y + 13 - up, accent(), 200);
+    }
+    int pos = 0;
+    int y = r.y + 32;
+    while (y < r.bottom() - 14 &&
+           nextLine(sister().line, &pos, 25, &budget, line)) {
+      text(b, line, r.x + 12, y, ink());
+      y += 15;
+    }
+    return;
+  }
+  if (numberOfItems() == 0) {
+    return;
+  }
+  int dx = s.banner * 4;
+  int fl = iround(2.f * sinf(s.phase * 0.12f));
+  roundFill(b, {r.x + 9, r.y + 13 + fl, 48, 48}, 11, accent(), 40);
+  drawItemIcon(b, s.selected, r.x + 11 + dx / 2, r.y + 11 + fl, false);
+  text(b, itemLabel(s.selected), r.x + 64 + dx, r.y + 10, ink(),
+       KDFont::Size::Large, Align::Left, r.w - 72);
+  int pos = 0;
+  int y = r.y + 34;
+  for (int k = 0;
+       k < 2 && nextLine(itemDesc(s.selected), &pos, 18, &budget, line); k++) {
+    text(b, line, r.x + 64 + dx, y, sub());
+    y += 14;
+  }
+  // bottom line
+  fill(b, {r.x + 10, r.bottom() - 22, r.w - 20, 1}, accent(), 70);
+  text(b, "OK : ouvrir", r.x + 12, r.bottom() - 19, accent());
+  char buf[16];
+  int i = appendInt(buf, 0, s.selected + 1);
+  i = appendText(buf, i, " / ");
+  appendInt(buf, i, numberOfItems());
+  text(b, buf, r.right() - 12, r.bottom() - 19, sub(), KDFont::Size::Small,
+       Align::Right);
+}
