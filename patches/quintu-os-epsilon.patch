+    lines += ["};", "", "}  // namespace QuintIcons", "}  // namespace Home", ""]
+    with open(out, "w") as f:
+        f.write("\n".join(lines))
+    if preview:
+        scale = 4
+        cols = 8
+        cell = 96
+        rows = (len(images) + cols - 1) // cols
+        sheet = Image.new("RGBA", (cols * cell * scale // 2, rows * 120 * scale // 2), hexc(0xFFF0F5))
+        for i, (_, img) in enumerate(images):
