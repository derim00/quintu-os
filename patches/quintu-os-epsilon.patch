+
+float clamp01(float t) { return t < 0.f ? 0.f : (t > 1.f ? 1.f : t); }
+float easeOut(float t) {
+  t = 1.f - clamp01(t);
+  return 1.f - t * t * t;
+}
+float easeBack(float t) {
+  t = clamp01(t) - 1.f;
+  return 1.f + t * t * (2.7f * t + 1.7f);
+}
+int iround(float v) { return static_cast<int>(roundf(v)); }
+
+Rect unite(Rect a, Rect b) {
+  if (a.isEmpty()) {
+    return b;
+  }
+  if (b.isEmpty()) {
+    return a;
+  }
+  int x = a.x < b.x ? a.x : b.x, y = a.y < b.y ? a.y : b.y;
+  int r = a.right() > b.right() ? a.right() : b.right();
+  int bt = a.bottom() > b.bottom() ? a.bottom() : b.bottom();
+  return {x, y, r - x, bt - y};
+}
+
+class Clip {
+ public:
+  Clip(Band& b, Rect r) : m_band(b), m_saved(b.clip()) {
+    m_ok = b.setClip(r.intersection(m_saved));
+  }
+  ~Clip() { m_band.setClip(m_saved); }
+  bool ok() const { return m_ok; }
+
+ private:
+  Band& m_band;
+  Rect m_saved;
+  bool m_ok;
+};
+
+int appendText(char* buf, int i, const char* t) {
+  while (*t && i < 38) {
+    buf[i++] = *t++;
+  }
+  buf[i] = 0;
+  return i;
+}
+
+int appendInt(char* buf, int i, int v) {
+  char d[8];
+  int n = 0;
+  do {
+    d[n++] = '0' + v % 10;
+    v /= 10;
+  } while (v > 0 && n < 7);
+  while (n > 0 && i < 38) {
+    buf[i++] = d[--n];
+  }
+  buf[i] = 0;
+  return i;
+}
+
+int batteryPercent() {
+  if (s_photo) {
+    return 82;
+  }
+  float v = Battery::voltage();
+  int p = static_cast<int>((v - 3.6f) * 100.f / (4.15f - 3.6f));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
+
+/* Word wrap: copies into out the next line of text (from *pos) that fits in
+ * maxChars, cut after *budget letters (typewriter). False when done. */
+bool nextLine(const char* text, int* pos, int maxChars, int* budget,
+              char* out) {
+  int p = *pos;
+  while (text[p] == ' ') {
+    p++;
+  }
+  if (!text[p] || *budget <= 0) {
+    out[0] = 0;
+    return false;
+  }
+  int end = p, lastSpace = -1;
+  while (text[end] && end - p < maxChars) {
+    if (text[end] == ' ') {
+      lastSpace = end;
+    }
+    end++;
+  }
+  if (text[end] && text[end] != ' ' && lastSpace > p) {
+    end = lastSpace;
+  }
+  int n = end - p;
+  int shown = n < *budget ? n : *budget;
+  if (shown > 46) {
+    shown = 46;
+  }
+  memcpy(out, text + p, shown);
+  out[shown] = 0;
+  *budget -= n;
+  *pos = end;
+  return true;
+}
