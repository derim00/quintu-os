+    c.poly([(70, 93), (58, 92), (50, 112), (60, PH), (74, PH)], fill=hexc(BLAZER_LIGHT))
+    c.poly([(40, 90), (50, 112), (60, 90), (50, 96)], fill=hexc(SHIRT))
