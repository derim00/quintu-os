+def petal_points(cx, cy, size, angle):
+    """A cherry blossom petal (a drop with a notch), turned by angle."""
+    pts = []
+    for k in range(40):
+        t = k / 39 * math.pi * 2
+        x = math.sin(t) * 0.55
+        y = -math.cos(t)
+        # narrower at the base, notch at the tip
+        x *= 0.55 + 0.45 * (1 - y) / 2 if y < 0 else 1
+        if y < -0.82:
+            y += (0.25 - abs(x) * 0.9) if abs(x) < 0.28 else 0
+        pts.append((x, y))
+    ca, sa = math.cos(angle), math.sin(angle)
+    return [(cx + size * (x * ca - y * sa), cy + size * (x * sa + y * ca) * 1) for x, y in pts]
+
+
+def make_petal(angle):
+    def draw(c):
+        c.poly(petal_points(50, 50, 44, math.radians(angle)), fill=WHITE)
+    return draw
+
+
+def heart_points(cx, cy, size):
+    pts = []
+    for k in range(60):
+        t = k / 60 * math.pi * 2
+        x = 16 * math.sin(t) ** 3
+        y = -(13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t))
+        pts.append((cx + x * size / 17, cy + y * size / 17))
+    return pts
+
