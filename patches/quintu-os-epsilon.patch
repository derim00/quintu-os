+def star_shape(cx, cy, r, inner=0.45, rot=-math.pi / 2):
+    pts = []
+    for i in range(10):
+        a = rot + i * math.pi / 5
+        rr = r if i % 2 == 0 else r * inner
+        pts.append((cx + rr * math.cos(a), cy + rr * math.sin(a)))
+    return pts
