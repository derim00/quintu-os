+/* ------------------------------------------------------------- petals */
+
+constexpr int k_petals = 14;
+struct Petal {
+  int16_t x, y;
+  uint8_t speed, sway;
+};
+Petal s_petals[k_petals];
+Rect s_petalRect[k_petals];
+bool s_petalsReady = false;
+
+void initPetals() {
+  uint32_t seed = 0x5A5Au;
+  for (int i = 0; i < k_petals; i++) {
+    seed = seed * 1103515245u + 12345u;
+    s_petals[i].x = (seed >> 8) % 330;
+    seed = seed * 1103515245u + 12345u;
+    s_petals[i].y = (seed >> 8) % 260;
+    s_petals[i].speed = 3 + (seed >> 20) % 4;
+    s_petals[i].sway = 3 + (seed >> 24) % 6;
+  }
+  s_petalsReady = true;
+}
+
+Rect petalRect(int i) {
+  const Petal& p = s_petals[i];
+  float y = fmodf(p.y + s.phase * p.speed * 0.22f, 260.f) - 12.f;
+  float x = p.x - 5 + s.phase * 0.25f +
+            p.sway * sinf(s.phase * 0.06f + i * 1.7f);
+  x = fmodf(x, 330.f);
+  if (x < 0) {
+    x += 330.f;
+  }
+  return {static_cast<int>(x) - 5, static_cast<int>(y), 9, 9};
+}
+
+int petalIcon(int i) {
+  int spin = (s.phase / 5 + i) % 4;
+  return spin == 0   ? QuintIcons::IconPetalA
+         : spin == 2 ? QuintIcons::IconPetalC
+                     : QuintIcons::IconPetalB;
+}
+
+void drawPetals(Band& b) {
+  for (int i = 0; i < k_petals; i++) {
+    Rect r = petalRect(i);
+    if (r.intersects(b.clip())) {
+      tinted(b, petalIcon(i), r.x, r.y, rgb(sister().petal),
+             150 + 25 * (i % 4));
+    }
+  }
+}
